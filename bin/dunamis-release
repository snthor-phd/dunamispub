#!/usr/bin/env python3
"""dunamis-release — publish a scheduled WordPress post right now.

  bin/dunamis-release <destination label> <post id> [--title "New title"] [--slug new-slug]

Skips the remaining scheduling window: flips status to `publish`, dates the
post now, and prints the permalink WordPress assigns.
"""

import json
import os
import sys
import urllib.request
from datetime import datetime, timezone

HERE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(HERE, "bin"))

from importlib.machinery import SourceFileLoader  # noqa: E402
pub = SourceFileLoader("pub", os.path.join(HERE, "bin", "dunamis-publish")).load_module()


def main():
    args = sys.argv[1:]
    opts = {}
    for flag in ("--title", "--slug"):
        if flag in args:
            i = args.index(flag)
            opts[flag[2:]] = args[i + 1]
            del args[i:i + 2]
    if len(args) != 2:
        raise SystemExit(__doc__)
    label, post_id = args

    config = json.load(open(os.path.join(HERE, "config.json")))
    dest = next(d for d in config["destinations"] if d["label"] == label)
    token = pub.keychain(dest["keychain_item"])

    payload = {"status": "publish",
               "date_gmt": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S")}
    payload.update(opts)
    req = urllib.request.Request(
        "%s/wp/v2/sites/%s/posts/%s" % (pub.API, dest["site_id"], post_id),
        data=json.dumps(payload).encode(), method="POST",
        headers={"Authorization": "Bearer %s" % token,
                 "Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=60) as resp:
        data = json.load(resp)
    pub.log("Released post %s on %s now (%s) — %s"
            % (post_id, label, data.get("status"), data.get("link")))
    print(data.get("status"), data.get("link"))


if __name__ == "__main__":
    main()
