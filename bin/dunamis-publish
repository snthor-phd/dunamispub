#!/usr/bin/env python3
"""dunamis-publish — post a Markdown file to a configured destination.

  bin/dunamis-publish <markdown> <destination label> [free text]

WordPress.com destinations post with status `future`, dated a few days out,
so there is a window to catch a mistake before anyone sees it. Jekyll
destinations commit a file into the site repo and run its deploy script.

Credentials come from the macOS Keychain. Nothing secret lives in this repo.
"""

import json
import os
import re
import subprocess
import sys
import urllib.request
import urllib.error
from datetime import datetime, timedelta, timezone

HERE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
LOG = os.path.expanduser("~/Library/Logs/dunamispub.log")
API = "https://public-api.wordpress.com"


def log(msg):
    line = "%s  %s" % (datetime.now().strftime("%Y-%m-%d %H:%M:%S"), msg)
    with open(LOG, "a") as fh:
        fh.write(line + "\n")
    print(line)


def keychain(service):
    r = subprocess.run(["security", "find-generic-password", "-s", service, "-w"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        raise SystemExit("No Keychain item '%s'. Run bin/dunamis-token first." % service)
    return r.stdout.strip()


def front_matter(path):
    """Split a Markdown file into (metadata dict, body)."""
    text = open(path, encoding="utf-8").read()
    meta = {}
    if text.startswith("---\n"):
        head, _, rest = text[4:].partition("\n---\n")
        for line in head.splitlines():
            if ":" in line:
                k, _, v = line.partition(":")
                meta[k.strip()] = v.strip()
        text = rest
    return meta, text.strip()


def to_html(markdown):
    """Paragraphs only. Scrivener prose has no headings or lists to preserve."""
    out = []
    for para in [p.strip() for p in markdown.split("\n\n") if p.strip()]:
        para = re.sub(r"\*\*(.+?)\*\*", r"<strong>\1</strong>", para)
        para = re.sub(r"(?<![\*\w])\*(?!\s)(.+?)(?<!\s)\*(?!\*)", r"<em>\1</em>", para)
        out.append("<p>%s</p>" % para.replace("\n", " "))
    return "\n\n".join(out)


def post_wordpress(dest, meta, body, schedule_days):
    token = keychain(dest["keychain_item"])
    when = datetime.now(timezone.utc) + timedelta(days=schedule_days)
    payload = {
        "title": meta.get("title", "Untitled"),
        "content": to_html(body),
        "status": "future" if schedule_days > 0 else "publish",
        "date": when.isoformat(),
    }
    if meta.get("synopsis"):
        payload["excerpt"] = meta["synopsis"]

    url = "%s/wp/v2/sites/%s/posts" % (API, dest["site_id"])
    req = urllib.request.Request(
        url, data=json.dumps(payload).encode("utf-8"), method="POST",
        headers={"Authorization": "Bearer %s" % token,
                 "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=60) as resp:
            data = json.load(resp)
    except urllib.error.HTTPError as e:
        raise SystemExit("WordPress refused the post (%s): %s"
                         % (e.code, e.read().decode("utf-8", "replace")[:400]))
    return data.get("link") or data.get("guid", {}).get("rendered", ""), when


def post_jekyll(dest, meta, body, md_path):
    repo = os.path.expanduser(dest["repo"])
    coll = os.path.join(repo, dest.get("collection_path", "_articles"))
    os.makedirs(coll, exist_ok=True)
    name = "%s-%s.md" % (datetime.now().strftime("%Y-%m-%d"),
                         os.path.splitext(os.path.basename(md_path))[0])
    target = os.path.join(coll, name)
    with open(target, "w") as fh:
        fh.write("---\ntitle: %s\ndate: %s\n---\n\n%s\n"
                 % (meta.get("title", "Untitled"),
                    datetime.now().strftime("%Y-%m-%d"), body))
    subprocess.run(["git", "-C", repo, "add", target], check=True)
    subprocess.run(["git", "-C", repo, "commit", "-m",
                    "Add article: %s" % meta.get("title", name)], check=True)
    deploy = dest.get("deploy")
    if deploy:
        subprocess.run([os.path.join(repo, deploy.lstrip("./"))], cwd=repo, check=False)
    else:
        subprocess.run(["git", "-C", repo, "push"], check=False)
    return dest.get("url", ""), None


def archive(dest, md_path, meta, link):
    """Copy the Markdown into the destination's content repo and record the URL."""
    repo = dest.get("archive_repo")
    if not repo:
        return
    repo = os.path.expanduser(repo)
    folder = os.path.join(repo, dest.get("archive_path", "published"))
    os.makedirs(folder, exist_ok=True)
    target = os.path.join(folder, os.path.basename(md_path))
    with open(md_path) as src, open(target, "w") as out:
        out.write(src.read())

    queue = dest.get("queue_file")
    topic = meta.get("id")
    if queue and topic:
        qpath = os.path.join(repo, queue)
        if os.path.exists(qpath):
            lines = open(qpath).read().splitlines()
            for i, line in enumerate(lines):
                if line.startswith("| %s " % topic):
                    parts = line.rsplit("|", 2)
                    lines[i] = "%s| published — %s |" % (parts[0], link)
                    break
            open(qpath, "w").write("\n".join(lines) + "\n")

    subprocess.run(["git", "-C", repo, "add", "-A"], check=False)
    subprocess.run(["git", "-C", repo, "commit", "-m",
                    "Publish %s" % meta.get("title", "post")], check=False)
    subprocess.run(["git", "-C", repo, "push"], check=False)


def main():
    if len(sys.argv) < 3:
        raise SystemExit(__doc__)
    md_path, label = sys.argv[1], sys.argv[2]
    free_text = sys.argv[3] if len(sys.argv) > 3 else None

    with open(os.path.join(HERE, "config.json")) as fh:
        config = json.load(fh)

    dest = next((d for d in config["destinations"] if d["label"] == label), None)
    if dest is None:
        log("No destination '%s' configured. Free text was: %s" % (label, free_text))
        raise SystemExit(1)

    meta, body = front_matter(md_path)
    days = config.get("publish", {}).get("schedule_days", 3)

    if dest["type"] == "wordpress":
        link, when = post_wordpress(dest, meta, body, days)
        log("Scheduled '%s' on %s for %s — %s"
            % (meta.get("title"), label, when.strftime("%Y-%m-%d %H:%M UTC"), link))
    elif dest["type"] == "jekyll":
        link, _ = post_jekyll(dest, meta, body, md_path)
        log("Committed '%s' to %s — %s" % (meta.get("title"), label, link))
    else:
        raise SystemExit("Unknown destination type: %s" % dest["type"])

    archive(dest, md_path, meta, link)
    print(link)


if __name__ == "__main__":
    main()
