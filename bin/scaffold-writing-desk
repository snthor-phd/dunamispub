#!/usr/bin/env python3
"""
scaffold-writing-desk — build a fresh Scrivener 3 "Writing Desk" project.

Creates a valid .scriv package with the DunamisPub binder layout, destination
labels, and workflow statuses, so a new user can go from nothing to a working
writing desk in one command.

Written against Scrivener 3.5.2, project format version 23.

SAFETY
  · Refuses to touch an existing project. Never overwrites.
  · Writes only inside the new package it creates.
  · Verify by opening the project in Scrivener before building anything on it.

Usage
  bin/scaffold-writing-desk "~/Documents/Writing Desk/Writing Desk.scriv" \
      --destinations "Adventures in Epsilon" "OVAC" "Northern Lights & Polar Bears"
"""

import argparse
import os
import sys
import uuid
from datetime import datetime
from xml.sax.saxutils import escape

FORMAT_VERSION = "23"
CREATOR = "SCRMAC-3.5.2-17487"

STATUSES = ["Idea", "Outlined", "Drafting", "Ready", "Scheduled", "Published"]

# Muted, legible label colors. Scrivener stores them as floating-point RGB.
LABEL_COLORS = [
    "0.702319 0.888276 0.974252",
    "0.760784 0.905882 0.752941",
    "0.850980 0.780392 0.933333",
    "0.993495 0.701207 0.732587",
    "0.984314 0.870588 0.607843",
]

RTF_TEMPLATE = (
    "{\\rtf1\\ansi\\ansicpg1252\\cocoartf2761\n"
    "{\\fonttbl\\f0\\fswiss\\fcharset0 Helvetica;}\n"
    "{\\colortbl;\\red255\\green255\\blue255;}\n"
    "\\pard\\partightenfactor0\n"
    "\\f0\\fs26 \\cf0 %s}"
)


def now():
    return datetime.now().astimezone().strftime("%Y-%m-%d %H:%M:%S %z")


def new_uuid():
    return str(uuid.uuid4()).upper()


class Item:
    """One node in the binder."""

    def __init__(self, title, kind="Folder", children=None, label=None, status=None,
                 body=None, synopsis=None, include=True):
        self.uuid = new_uuid()
        self.title = title
        self.kind = kind
        self.children = children or []
        self.label = label
        self.status = status
        self.body = body
        self.synopsis = synopsis
        self.include = include

    def xml(self, ts, depth=2):
        pad = "    " * depth
        out = [f'{pad}<BinderItem UUID="{self.uuid}" Type="{self.kind}" '
               f'Created="{ts}" Modified="{ts}">']
        out.append(f"{pad}    <Title>{escape(self.title)}</Title>")
        out.append(f"{pad}    <MetaData>")
        out.append(f"{pad}        <IncludeInCompile>"
                   f"{'Yes' if self.include else 'No'}</IncludeInCompile>")
        if self.label is not None:
            out.append(f"{pad}        <LabelID>{self.label}</LabelID>")
        if self.status is not None:
            out.append(f"{pad}        <StatusID>{self.status}</StatusID>")
        out.append(f"{pad}    </MetaData>")
        if self.children:
            out.append(f"{pad}    <Children>")
            for child in self.children:
                out.append(child.xml(ts, depth + 2))
            out.append(f"{pad}    </Children>")
        out.append(f"{pad}</BinderItem>")
        return "\n".join(out)

    def walk(self):
        yield self
        for child in self.children:
            yield from child.walk()


def build_binder(destinations, year, seeds):
    """Assemble the standard DunamisPub binder."""
    ideas = Item("Ideas", children=[
        Item(title, kind="Text", label=0, status=0, body=body, synopsis=synopsis)
        for title, synopsis, body in seeds
    ])

    published = Item("Published", children=[
        Item(name, children=[Item(str(year))]) for name in destinations
    ])

    draft = Item("Writing Desk", kind="DraftFolder", children=[
        ideas,
        Item("In Progress"),
        Item("Ready to Post"),
        published,
        Item("Template", include=False),
    ])

    return [draft,
            Item("Research", kind="ResearchFolder", include=False),
            Item("Trash", kind="TrashFolder", include=False)]


def render(roots, destinations, author):
    ts = now()
    parts = ['<?xml version="1.0" encoding="UTF-8"?>',
             f'<ScrivenerProject Identifier="{new_uuid()}" Version="2.0" '
             f'Creator="{CREATOR}" Author="{escape(author)}" '
             f'Modified="{ts}" ModID="{new_uuid()}">',
             "    <Binder>"]
    for root in roots:
        parts.append(root.xml(ts))
    parts.append("    </Binder>")

    parts.append("    <LabelSettings>")
    parts.append("        <Title>Destination</Title>")
    parts.append("        <DefaultLabelID>-1</DefaultLabelID>")
    parts.append("        <Labels>")
    parts.append('            <Label ID="-1">No Label</Label>')
    for i, name in enumerate(destinations + ["Something Else"]):
        color = LABEL_COLORS[i % len(LABEL_COLORS)]
        parts.append(f'            <Label ID="{i}" Color="{color}">{escape(name)}</Label>')
    parts.append("        </Labels>")
    parts.append("    </LabelSettings>")

    parts.append("    <StatusSettings>")
    parts.append("        <Title>Status</Title>")
    parts.append("        <DefaultStatusID>-1</DefaultStatusID>")
    parts.append("        <StatusItems>")
    parts.append('            <Status ID="-1">No Status</Status>')
    for i, name in enumerate(STATUSES):
        parts.append(f'            <Status ID="{i}">{name}</Status>')
    parts.append("        </StatusItems>")
    parts.append("    </StatusSettings>")
    parts.append("</ScrivenerProject>")
    return "\n".join(parts) + "\n"


def main():
    ap = argparse.ArgumentParser(description="Build a Scrivener Writing Desk project.")
    ap.add_argument("path", help="Destination .scriv path")
    ap.add_argument("--destinations", nargs="+", required=True,
                    help="Blog names — these become the Scrivener labels")
    ap.add_argument("--author", default=os.environ.get("USER", ""))
    ap.add_argument("--year", type=int, default=datetime.now().year)
    args = ap.parse_args()

    path = os.path.abspath(os.path.expanduser(args.path))
    if os.path.exists(path):
        sys.exit(f"Refusing to overwrite an existing project: {path}")
    if not path.endswith(".scriv"):
        sys.exit("Path must end in .scriv")

    seeds = [(
        "Untitled — your first piece",
        "Replace this synopsis with the angle of the piece.",
        "Start writing here.",
    )]

    roots = build_binder(args.destinations, args.year, seeds)

    os.makedirs(os.path.join(path, "Files", "Data"))
    os.makedirs(os.path.join(path, "Settings"))
    os.makedirs(os.path.join(path, "QuickLook"))

    with open(os.path.join(path, "Files", "version.txt"), "w") as fh:
        fh.write(FORMAT_VERSION)

    for root in roots:
        for item in root.walk():
            if item.kind != "Text":
                continue
            data_dir = os.path.join(path, "Files", "Data", item.uuid)
            os.makedirs(data_dir)
            with open(os.path.join(data_dir, "content.rtf"), "w") as fh:
                fh.write(RTF_TEMPLATE % (item.body or ""))
            if item.synopsis:
                with open(os.path.join(data_dir, "synopsis.txt"), "w") as fh:
                    fh.write(item.synopsis)

    name = os.path.splitext(os.path.basename(path))[0]
    with open(os.path.join(path, f"{name}.scrivx"), "w") as fh:
        fh.write(render(roots, args.destinations, args.author))

    print(f"Built {path}")
    print("Open it in Scrivener and confirm the binder before building on it.")


if __name__ == "__main__":
    main()
